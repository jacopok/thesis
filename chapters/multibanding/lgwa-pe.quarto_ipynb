        "cmap = cm.vik\n",
        "true_m = injection_params['chirp_mass']\n",
        "std = np.std(post_equal['chirp_mass'])\n",
        "norm = Normalize(- 3*std, + 3*std)\n",
        "\n",
        "idx_mass = int(np.where(post_equal.columns == 'chirp_mass')[0][0])\n",
        "idx_mass_ratio = int(np.where(post_equal.columns == 'mass_ratio')[0][0])\n",
        "idx_time = int(np.where(post_equal.columns == 'time_at_center')[0][0])\n",
        "\n",
        "for sample in post_equal.to_numpy()[:100]:\n",
        "    m = sample[idx_mass]\n",
        "    q = sample[idx_mass_ratio]\n",
        "    time = sample[idx_time]\n",
        "    plt.semilogx(fs, \n",
        "    time_to_merger(m, q, fs) + time \n",
        "    - (time_to_merger(injection_params['chirp_mass'], injection_params['mass_ratio'], fs)\n",
        "    + injection_params['time_at_center']), \n",
        "    c=cmap(norm(m-true_m)),\n",
        "    alpha=.8)\n",
        "plt.colorbar(ScalarMappable(cmap=cmap, norm=norm), ax=plt.gca(), label='Chirp mass deviation [Msun]')\n",
        "plt.xlabel('Frequency [Hz]')\n",
