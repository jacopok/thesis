    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import astropy.units as u\n",
        "month_seconds = (29.5*u.day).si.value\n",
        "AU = (1*u.AU).si.value\n",
        "t0 = injection_params['time_at_center']\n",
        "# construct a plane from three points:\n",
        "\n",
        "# SSB center\n",
        "a = np.zeros(3)\n",
        "# lunar position (from SSB center)\n",
        "b = like.get_detector_position(t0)\n",
        "# lunar position 3 months earlier (from SSB center)\n",
        "c = like.get_detector_position(t0 - 3*month_seconds)\n",
        "\n",
        "# compute plane normal from two vectors in the plane\n",
        "normal = np.cross((b-a), (c-a))\n",
        "normal /= np.linalg.norm(normal)\n",
        "\n",
        "# compute two other basis vectors\n",
        "n = -np.cross((b-a), normal)\n",
        "m = np.cross(n, normal)\n",
        "\n",
        "n /= np.linalg.norm(n)\n",
        "m /= np.linalg.norm(m)\n",
        "\n",
        "def project(point):\n",
        "    return np.array([np.dot(n, point), np.dot(m, point)])\n",
        "\n",
        "def deproject(n_coords, m_coords):\n",
        "    return (\n",
        "        np.tensordot(n, n_coords, axes=0) +\n",
        "        np.tensordot(m, m_coords, axes=0)\n",
        "    )\n",
        "\n",
        "times = np.linspace(t0-2*month_seconds, t0, num=1000)\n",
        "\n",
        "detector_motion = project(like.get_detector_position(times))\n",
        "plt.plot(*detector_motion/AU, lw=.5, c='black')"
      ],
      "id": "289eabc9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from thesis_scripts.lgwa_pe.lunar_coordinates import spherical_to_cartesian\n",
        "from thesis_scripts.lgwa_pe.lgwa_likelihood import SPEED_OF_LIGHT\n",
        "from thesis_scripts import data_path\n",
        "from tqdm import tqdm\n",
        "\n",
        "samples_to_use = 2000\n",
        "chirp_mass = post_equal['chirp_mass'].to_numpy()[:samples_to_use]\n",
        "q = post_equal['mass_ratio'].to_numpy()[:samples_to_use]\n",
        "ra = post_equal['ra'].to_numpy()[:samples_to_use]\n",
        "dec = post_equal['dec'].to_numpy()[:samples_to_use]\n",
        "t = post_equal['time_at_center'].to_numpy()[:samples_to_use]\n",
        "k = spherical_to_cartesian(ra, dec)\n",
        "\n",
        "center_0 = like.get_detector_position(t0)\n",
        "\n",
        "def shifted_center_time_std(center, f):\n",
        "    time_at_new_center = t + time_to_merger(chirp_mass, q, f) + np.dot(k, center-center_0) / SPEED_OF_LIGHT\n",
        "\n",
        "    return np.std(time_at_new_center)"
      ],
      "id": "5425e198",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from cmcrameri import cm\n",
        "from matplotlib.colors import Normalize\n",
        "\n",
        "num_grid = 40\n",
        "num_freqs = 40\n",
        "freqs = np.geomspace(0.6, 1, num=num_freqs)\n",
        "times = injection_params['time_at_center'] + time_to_merger(\n",
        "    injection_params['chirp_mass'],\n",
        "    injection_params['mass_ratio'], \n",
        "    freqs\n",
        ")\n",
        "n_range = np.linspace(-1.2, 1.2, num=num_grid)*AU\n",
        "m_range = np.linspace(-0.4, 1.5, num=num_grid)*AU\n",
        "N, M = np.meshgrid(n_range, m_range)\n",
        "\n",
        "full_grid = deproject(N, M).reshape((3, num_grid**2)).T\n",
        "\n",
        "cmap = cm.glasgow\n",
        "norm = Normalize(0.05, 0.15, clip=True)\n",
        "\n",
        "fname = data_path / 'cache' / 'shifted_center_time_stds.npy'\n",
        "\n",
        "if fname.exists():\n",
        "    stds = np.load(fname)\n",
        "else:\n",
        "    \n",
        "    stds = np.empty((num_freqs, num_grid**2))\n",
        "    for i, f in enumerate(freqs):\n",
        "        stds[i] = np.array([shifted_center_time_std(center, f) for center in tqdm(full_grid)])\n",
        "    np.save(fname, stds)\n",
        "\n",
        "i = 24\n",
        "\n",
        "\n",
        "plt.colorbar(\n",
        "    plt.contourf(\n",
        "        N/AU, M/AU, \n",
        "        stds[i].reshape((num_grid, num_grid)), \n",
        "        levels=50,\n",
        "        cmap=cmap,\n",
        "        norm=norm,\n",
        "    ), \n",
        "    label='Timing uncertainty [s]')\n",
        "plt.plot(*detector_motion/AU, lw=.5, c='white')\n",
        "plt.scatter(*project(\n",
        "    like.get_detector_position(times[i]))/AU, \n",
        "    c='white', s=10, label='Moon position')\n",
        "\n",
        "plt.title(f'f={freqs[i]:.2f}, {-(times[i] - injection_params[\"time_at_center\"])/month_seconds:.2f} months to merger')\n",
        "\n",
        "plt.legend()"
      ],
      "id": "a95177a2",
      "execution_count": null,
      "outputs": []
    }
