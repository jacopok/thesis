        "plot_contours(post_ew['ra'], post_ew['dec'], ax=plt.gca(), levels=[.9], cmap=cmap_ew)\n",
        "plot_contours(post_full['ra'], post_full['dec'], ax=plt.gca(), levels=[.9], cmap=cmap_full)\n",
        "plt.scatter(params['ra'], params['dec'], marker='x', c='black')\n",
        "\n",
        "make_arcmin_grid(plt.gca(), ra_lims, dec_lims)\n",
        "plt.grid(which='minor', lw=.5)\n",
        "plt.grid(which='major', lw=1)\n",
        "plt.gca().set_aspect('equal')\n",
        "plt.xlabel('Right ascension')\n",
        "plt.ylabel('Declination')\n",
        "make_legend()\n",
        "_ = plt.title(r'90\\% localization contours')"
      ],
      "id": "79554d25",
