    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Parameter estimation: setup\n",
        "\n",
        "- Parameters: same as GW170817\n",
        "- zero-noise\n",
        "- observation time: \n",
        "    - 10 years, up to ~3hr before merger\n",
        "    - 9.6 years, up to ~4.5 months before merger\n",
        "- accelerated nested sampling with Ultranest\n",
        "\n",
        "# Mass constraints\n"
      ],
      "id": "680c7f97"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from thesis_scripts.plotting import plot_contours\n",
        "from matplotlib import ticker\n",
        "from matplotlib.lines import Line2D\n",
        "import pandas as pd\n",
        "\n",
        "from cmcrameri import cm\n",
        "\n",
        "cmap_full = cm.lajolla\n",
        "cmap_ew = cm.devon\n",
        "\n",
        "def make_legend():\n",
        "\n",
        "    custom_lines = [\n",
        "        Line2D([0], [0], color=cmap_ew(.5), markersize=10, marker='o', lw=0),\n",
        "        Line2D([0], [0], color=cmap_full(.5), markersize=10, marker='o', lw=0),\n",
        "    ]\n",
        "    \n",
        "    plt.legend(\n",
        "        custom_lines, \n",
        "        [\n",
        "            f'Early warning (4.5 months to merger, SNR 20)',\n",
        "            f'Full bandwidth (3 hours to merger, SNR 28)',\n",
        "        ]\n",
        "    )\n",
        "\n",
        "post_ew = pd.read_csv(data_path / 'ew_gw170817_run' / 'chains' / 'equal_weighted_post.txt', sep=' ')\n",
        "post_full = pd.read_csv(data_path / 'gw170817_run' / 'chains' / 'equal_weighted_post.txt', sep=' ')\n",
        "\n",
        "# ra_lims = (3.442, 3.449)\n",
        "# dec_lims = (-0.412, -0.405)\n",
        "\n",
        "# filter_indices = (\n",
        "#     (post_ew_pre['ra'] > ra_lims[0]).to_numpy() & \n",
        "#     (post_ew_pre['ra'] < ra_lims[1]).to_numpy() & \n",
        "#     (post_ew_pre['dec'] > dec_lims[0]).to_numpy() & \n",
        "#     (post_ew_pre['dec'] < dec_lims[1]).to_numpy()\n",
        "# )\n",
        "\n",
        "# print(f'Filtering out {len(filter_indices) - sum(filter_indices)} outliers')\n",
        "\n",
        "# post_ew = post_ew_pre.iloc[filter_indices]\n",
        "\n",
        "\n",
        "# fig = plt.figure(figsize=(5.2, 5.5))\n",
        "\n",
        "mc = params['chirp_mass']\n",
        "\n",
        "x = np.linspace(-3e-7, 4e-7, num=100)\n",
        "y = np.linspace(0.825, 1, num=100)\n",
        "\n",
        "# plot_contours(post_ew['chirp_mass']-mc, post_ew['mass_ratio'], ax=plt.gca(), levels=[.9], cmap=cmap_ew, x=x, y=y, N=100)\n",
        "plot_contours(post_full['chirp_mass']-mc, post_full['mass_ratio'], ax=plt.gca(), levels=[.9], cmap=cmap_full)\n",
        "plt.grid(which='both')\n",
        "plt.scatter(0, params['mass_ratio'], marker='x', c='black')\n",
        "plt.gca().xaxis.set_major_locator(ticker.FixedLocator(np.arange(-3, 4)*1e-7))\n",
        "plt.gca().xaxis.set_major_formatter(ticker.FixedFormatter(\n",
        "    [\n",
        "        '$- 3 \\\\times 10^{-7}$',\n",
        "        '$- 2 \\\\times 10^{-7}$',\n",
        "        '$-10^{-7}$',\n",
        "        '$0$',\n",
        "        '$10^{-7}$',\n",
        "        '$2 \\\\times 10^{-7}$',\n",
        "        '$3 \\\\times 10^{-7}$',\n",
        "    ]\n",
        "))\n",
        "\n",
        "plt.xlabel('$\\mathcal{M} - \\mathcal{M}_0 [ M_{\\odot}]$')\n",
        "plt.ylabel('$q = m_2 / m_1$')\n",
        "make_legend()\n",
        "_ = plt.title(r'90\\% mass contours')"
      ],
      "id": "3dce2510",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
